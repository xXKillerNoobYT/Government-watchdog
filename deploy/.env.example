# DEPLOY-2026 (GOV-722) — environment template. COMMITTED, placeholders only.
#
# Copy to deploy/.env (gitignored) and fill real values there. A test asserts
# this file contains NO secret-shaped values (PORT-4). Never commit deploy/.env.

# Where the mounted registry + logs live. Point at a SYNTHETIC/scratch dir for
# drills — never the real vault (INV-7). Default is deploy/data (gitignored).
DATA_DIR=./data

# --- scale-shape profile: local postgres:16 stand-in (drill only) ------------
# These are LOCAL container credentials for a throwaway drill DB, not cloud
# secrets. Replace before any non-local use.
POSTGRES_USER=CHANGE_ME_local_only
POSTGRES_PASSWORD=CHANGE_ME_local_only
POSTGRES_DB=portability_drill

# psql DSN the portability drill uses for --backend postgres (leg 4). Built from
# the values above; keep it pointing at the local container.
# GOV722_PG_DSN=postgresql://CHANGE_ME_local_only:CHANGE_ME_local_only@localhost:5432/portability_drill
