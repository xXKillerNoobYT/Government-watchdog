Raw-PDFs/
Transcripts/
# GOV-124 managed local-corpus raw store — snapshotted raw bytes from the on-disk
# Alpine corpus (data-publication boundary; raw stays local/vault-only).
Raw-Corpus/
# Operational ingest run logs (Lane 1) — local/vault-only, never committed
# (data-publication boundary; GOV-75 / 1.04-g). Acceptance/verification evidence
# logs (e.g. Logs/acceptance.log) are deliberately committed and summary-only.
Logs/crawl-*.log
# Lane 2 AI gateway (GOV-89 / 1.09 §7.1, 1.11 §2.1): the local provider config
# and AI extraction run logs are reviewer/vault-only — never committed. The
# ai_extraction_runs ledger lives in Database/*.db (already ignored above).
Database/ai_provider.local.json
Logs/ai-extract-*.log
# GOV-138 Option-B (GOV-141): agent-inline claims file holds REAL verbatim Alpine
# quotes; the volume-run logs/reports replay real quoted_text. Reviewer/vault-only,
# never committed (C1/B3). Only the harness CODE (no real data) is committed.
Database/gov138_agent_inline_claims*.json
Logs/gov138-*.log
Database/gov138-run-report*.json
# GOV-149 reviewer-internal concept-graph seed run logs: replay real char-span
# offsets + served topic_tree over the real Alpine corpus. Reviewer/vault-only,
# never committed. Only the seed CODE + tests (no real data) are committed.
Logs/gov149-*.log
# GOV-162 batch-2 agent-inline claims: real verbatim Alpine quotes, vault-only.
Docs/gov162-claims-batch2.json
Logs/gov162-*.log
# GOV-161 P&Z Board body→topic seed run logs: replay real topic_tree + grounding
# over the real Alpine corpus. Reviewer/vault-only, never committed.
Logs/gov161-*.log
# GOV-192 batch-3 agent-inline claims + promotion run logs: real verbatim Alpine
# quotes and char-span offsets. Reviewer/vault-only, never committed.
Database/gov192_batch3_claims.json
Logs/gov192-*.log
# GOV-195 batch-4 agent-inline claims + promotion run logs: real verbatim Alpine
# quotes and char-span offsets. Reviewer/vault-only, never committed.
Database/gov195_batch4_claims.json
Logs/gov195-*.log
# GOV-200 batch-5 agent-inline claims + promotion run logs: real verbatim Alpine
# quotes and char-span offsets. Reviewer/vault-only, never committed.
Database/gov200_batch5_claims.json
Logs/gov200-*.log
